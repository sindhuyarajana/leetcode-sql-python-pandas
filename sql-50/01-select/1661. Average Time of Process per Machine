#1661. Average Time of Process per Machine
SELECT
    a.machine_id,
    ROUND(
        AVG(
            a.timestamp - b.timestamp
        ), 3
    ) AS processing_time
FROM activity a
INNER JOIN activity b
ON a.machine_id = b.machine_id
WHERE a.activity_type = 'end' 
      AND
      b.activity_type = 'start'
GROUP BY machine_id;
